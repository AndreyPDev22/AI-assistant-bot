# Copy to backend/.env. Run all backend commands from backend/.
# With a local PostgreSQL role matching your OS username, no login/password is needed.
DATABASE_URL=postgresql+psycopg://localhost:5432/ai_assistant
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Set true behind HTTPS in production.
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
# Tests require a SEPARATE database. Its name must end with _test.
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/ai_assistant_test
