{
  "name": "ai-aasistant-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "lintfix": "eslint . --fix && prettier --write --list-different .",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "camelcase-keys": "^10.0.3",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^4.1.0",
    "vue": "^3.5.42",
    "vue3-toastify": "^0.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "snakecase-keys": "^9.0.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "msw": {
    "workerDirectory": [
      "src/mocks"
    ]
  }
}
